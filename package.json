{
  "name": "@stephenliang/toolkit",
  "version": "0.1.0",
  "description": "Shared tooling configs (eslint, prettier, tsconfig, lint-staged, vitest, vite) for personal repos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephenliang/toolkit.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/vitest": "./eslint/vitest.js",
    "./prettier": "./prettier/index.js",
    "./typescript/*": "./typescript/*.json",
    "./lint-staged": "./lint-staged/index.js",
    "./vitest/react": "./vitest/react.js",
    "./vite/lib": "./vite/lib.js"
  },
  "files": [
    "eslint",
    "prettier",
    "typescript",
    "lint-staged",
    "vitest",
    "vite"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/smoke.mjs"
  },
  "prettier": "./prettier/index.js",
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/eslint-plugin": "^1.3.16",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-import-x": "^4.16.1",
    "globals": "^16.0.0",
    "prettier-plugin-packagejson": "^2.5.5",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": ">=6",
    "eslint": ">=10",
    "eslint-plugin-jsx-a11y": ">=6",
    "eslint-plugin-react": ">=7.37",
    "prettier": ">=3",
    "typescript": ">=5.9",
    "vite": ">=7",
    "vite-plugin-dts": ">=4",
    "vite-plugin-externalize-deps": ">=0.9",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-dts": {
      "optional": true
    },
    "vite-plugin-externalize-deps": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
